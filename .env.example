# Скопируйте в .env и заполните. Все значения ниже — значения по умолчанию или примеры.

# --- Окружение --------------------------------------------------------------------
# production отключает документацию API и запрещает AUTH_MODE=dev
ENVIRONMENT=production

# --- База данных ---------------------------------------------------------------------
POSTGRES_DB=dostup
POSTGRES_USER=dostup
POSTGRES_PASSWORD=смените-этот-пароль

# --- Публикация -------------------------------------------------------------------------
# Путь, по которому портал открывает вкладку. Со слешами в начале и в конце.
APP_BASE_PATH=/access/
# Адрес и порт, на которых nginx принимает запросы от портала
HTTP_BIND=0.0.0.0
HTTP_PORT=8081
# Адреса портала, которым разрешено встраивать вкладку во фрейм (через «;»)
PORTAL_ORIGINS=https://portal.company.ru

# --- Кто пользователь ---------------------------------------------------------------
# headers — личность передаёт обратный прокси портала после входа через AD
# jwt     — портал передаёт подписанный токен
# dev     — выбор тестового пользователя в интерфейсе, только для разработки
AUTH_MODE=headers

# Группы AD, члены которых становятся администраторами системы заявок (через «;»).
# Можно указывать имя группы или полный DN.
ADMIN_GROUPS=РНСК-Заявки-Администраторы

# Режим headers. Имена заголовков, которые выставляет прокси портала.
# Кириллицу в значениях прокси должен передавать в UTF-8 или percent-encoding.
HEADER_LOGIN=X-Remote-User
HEADER_NAME=X-Remote-Name
HEADER_EMAIL=X-Remote-Email
HEADER_DEPARTMENT=X-Remote-Department
HEADER_GROUPS=X-Remote-Groups
# Адреса прокси портала. Заголовки с любых других адресов игнорируются (через «;»)
TRUSTED_PROXIES=10.0.0.10/32

# Режим jwt. Нужен один из способов проверки подписи.
# JWT_JWKS_URL=https://sso.company.ru/realms/portal/protocol/openid-connect/certs
# JWT_PUBLIC_KEY=
# JWT_SECRET=
# JWT_ALGORITHMS=RS256
# JWT_ISSUER=https://sso.company.ru/realms/portal
# JWT_AUDIENCE=dostup
# JWT_COOKIE_NAME=
# JWT_CLAIM_LOGIN=preferred_username
# JWT_CLAIM_NAME=name
# JWT_CLAIM_EMAIL=email
# JWT_CLAIM_DEPARTMENT=department
# JWT_CLAIM_GROUPS=groups
